---
import mission from "../../data/mission.json";
const base = import.meta.env.BASE_URL;
---
<header id="top" class="apple-gutter parallax-stage" style="padding-top: 24px; padding-bottom: 32px">
  {/* Parallax background — transparent sat render floating behind content */}
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-glow"></div>
    <div id="hero-sat-layer" class="parallax-layer">
      <img
        id="hero-sat-img"
        class="parallax-img"
        src={`${base}sinfondo3.png`}
        alt=""
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="hero-scrim"></div>
  </div>

  <div id="hero-foreground" class="parallax-fg">
    <div class="reveal flex justify-start" style="margin-bottom: 16px">
      <span class="inline-flex min-h-[32px] items-center gap-2 rounded-full px-3 type-footnote" style="background: color-mix(in srgb, var(--system-green) 14%, transparent); color: var(--system-green); font-weight: 600">
        <span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: currentColor; display: inline-block"></span>
        {mission.status}
      </span>
    </div>

    <div class="hero-single">
      <div id="large-title-wrap">
        <p class="type-eyebrow" style="color: var(--secondary-label); margin-bottom: 8px">ARTS · CICESE · SEDENA · UDEFA</p>
        <h1 class="type-largeTitle" style="text-wrap: balance">PAINANI-1
          <span class="block type-title2" style="color: var(--secondary-label); margin-top: 8px; font-weight: 600">{mission.fullName}</span>
        </h1>
        <p class="type-title3" style="margin-top: 16px; max-width: 560px; font-weight: 400">{mission.tagline}</p>
      </div>
      <p class="type-body reveal" style="color: var(--secondary-label); max-width: 600px; margin-top: 16px">{mission.description}</p>
      <div class="reveal flex flex-wrap" style="gap: 12px; margin-top: 24px">
        <a href="#viaje" class="apple-btn apple-btn-filled">Explorar el viaje
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 2v9M3.5 7.5L7 11l3.5-3.5"/></svg>
        </a>
        <a href="#fotos" class="apple-btn apple-btn-gray">Ver fotos SAT</a>
      </div>
      <p class="sf-mono type-caption1 reveal" style="color: var(--tertiary-label); margin-top: 16px; letter-spacing: 0.04em">
        COSPAR 2019-037A &nbsp;·&nbsp; NORAD 44365 &nbsp;·&nbsp; 29 JUN 2019
      </p>
    </div>
  </div>
</header>

<script>
  // Apple-style parallax: scroll depth + idle float.
  // Spring-like lerp on scroll retargets every frame → physical & interruptible.
  (() => {
    const stage = document.getElementById("top");
    const layer = document.getElementById("hero-sat-layer");
    const img = document.getElementById("hero-sat-img");
    const fg = document.getElementById("hero-foreground");
    if (!stage || !layer) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const lerp = (a, b, n) => a + (b - a) * n;
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

    let cSY = 0; // smoothed scroll offset
    const t0 = performance.now();

    const frame = (t) => {
      const el = (t - t0) / 1000;
      const r = stage.getBoundingClientRect();
      const sY = -r.top; // px scrolled past hero top

      cSY = lerp(cSY, sY, 0.12);

      // Gentle idle bob, like floating in orbit
      const floatY = Math.sin((el * Math.PI * 2) / 7) * 10;
      const floatR = Math.sin((el * Math.PI * 2) / 9) * 1.2;

      // Background drifts slower than scroll → depth; clamped so it never gaps
      const bgY = clamp(cSY * 0.12, -120, 120);
      layer.style.transform = `translate3d(0, ${bgY + floatY * 0.6}px, 0)`;
      if (img) {
        img.style.transform = `translate3d(0, ${floatY}px, 0) rotate(${floatR}deg) scale(1.08)`;
      }
      // Foreground counter-drifts a touch — subtle foreground/background split
      if (fg) fg.style.transform = `translate3d(0, ${clamp(cSY * -0.04, -40, 40)}px, 0)`;

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  })();
</script>

<style>
  .hero-single { max-width: 660px; }
  @media (min-width: 900px) {
    header.parallax-stage { min-height: 560px; }
  }

  #hero-foreground { position: relative; z-index: 1; will-change: transform; }

  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    perspective: 1200px; pointer-events: none;
  }
  #hero-sat-layer {
    position: absolute; top: -8%; bottom: -8%; right: -4%;
    width: min(64%, 640px);
  }
  #hero-sat-img {
    width: 100%; height: 100%;
    object-fit: contain; object-position: right center;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.35));
  }
  .hero-glow {
    position: absolute; right: -12%; top: 4%;
    width: min(64%, 620px); aspect-ratio: 1;
    background: radial-gradient(closest-side,
      color-mix(in srgb, var(--system-blue) 22%, transparent),
      transparent 70%);
  }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      var(--grouped-background) 18%,
      color-mix(in srgb, var(--grouped-background) 72%, transparent) 46%,
      transparent 72%);
  }

  /* Mobile: render becomes ambient texture behind text */
  @media (max-width: 899px) {
    #hero-sat-layer { width: 110%; right: -42%; opacity: 0.4; }
    .hero-glow { right: -40%; width: 120%; }
    .hero-scrim {
      background: linear-gradient(180deg,
        color-mix(in srgb, var(--grouped-background) 30%, transparent) 0%,
        color-mix(in srgb, var(--grouped-background) 78%, transparent) 62%,
        var(--grouped-background) 96%);
    }
  }
</style>
