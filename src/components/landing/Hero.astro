---
import mission from "../../data/mission.json";
---
<header id="top" class="hero-grid relative overflow-hidden pt-24">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 pb-14 pt-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
    <div>
      <p class="telemetry-mono mb-3 inline-block rounded-full border border-green-400/30 bg-green-400/10 px-3 py-1 text-xs font-semibold text-green-300">
        ● {mission.status}
      </p>
      <h1 class="text-4xl font-black leading-tight md:text-6xl">
        PAINANI-1
        <span class="block text-xl font-bold text-blue-300 md:text-2xl">{mission.fullName}</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg text-gray-300">{mission.tagline}</p>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-gray-400">{mission.description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#viaje" class="rounded-full bg-blue-600 px-6 py-2.5 font-bold shadow-lg transition hover:bg-blue-500">
          Explorar el Voyage ↓
        </a>
        <a href="#fotos" class="rounded-full border border-white/20 bg-white/5 px-6 py-2.5 font-bold transition hover:bg-white/10">
          Ver fotos SAT
        </a>
      </div>
      <div class="telemetry-mono mt-6 flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-400">
        <span><span class="text-gray-500">COSPAR</span> 2019-037A</span>
        <span><span class="text-gray-500">NORAD</span> 44365</span>
        <span><span class="text-gray-500">LANZAMIENTO</span> 29 JUN 2019</span>
        <span><span class="text-gray-500">ARCHIVO</span> ENE 2020 – ENE 2023</span>
      </div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-gray-900/80 p-5 shadow-2xl">
      <h2 class="telemetry-mono mb-3 text-xs font-bold tracking-widest text-blue-300">DATOS RÁPIDOS DE MISIÓN</h2>
      <dl class="divide-y divide-white/10">
        {mission.quickFacts.map((f) => (
          <div class="flex items-center justify-between gap-4 py-2">
            <dt class="text-sm text-gray-400">{f.label}</dt>
            <dd class="telemetry-mono text-right text-sm font-semibold text-white">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</header>
