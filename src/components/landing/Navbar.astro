---
import { Image } from "astro:assets";
import logo from "../../assets/painani1.png";

const base = import.meta.env.BASE_URL;
const kioskHref = `${base}kiosk/`;

const links = [
  { href: "#mision", label: "Misión" },
  { href: "#lanzamiento", label: "Video" },
  { href: "#viaje", label: "Viaje" },
  { href: "#fotos", label: "Fotos" },
  { href: "#hitos", label: "Hitos" },
];
---
<nav id="apple-nav" class="material-nav hairline-b fixed inset-x-0 top-0 z-50" style="padding-top: env(safe-area-inset-top)">
  <div class="apple-gutter">
    <div class="flex items-center justify-between gap-2" style="min-height: 56px">
      {/* Leading: identity */}
      <a href="#top" class="pressable flex min-h-[44px] min-w-[44px] items-center gap-2 rounded-xl" aria-label="PAINANI-1 inicio">
        <Image src={logo} alt="PAINANI-1" width={30} height={30} densities={[1, 2]} class="h-[30px] w-[30px] rounded-full object-cover" style="box-shadow: var(--shadow-1)" />
        <span id="apple-nav-inline-title" class="type-headline" style="font-size: 17px">PAINANI-1</span>
      </a>

      {/* Center: structural nav — no burger menu, inline links on ≥md */}
      <div class="hidden items-center gap-1 md:flex" role="navigation" aria-label="Secciones">
        {links.map((l) => (
          <a href={l.href} data-spy class="apple-btn-plain type-subhead" style="font-weight: 500">{l.label}</a>
        ))}
      </div>

      {/* Trailing: kiosk */}
      <div class="flex items-center gap-2">
        <a
          href={kioskHref}
          class="pressable apple-btn-plain type-subhead"
          style="font-weight: 500; gap: 6px"
          aria-label="Abrir modo kiosko a pantalla completa"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="13" rx="2" />
            <path d="M8 20.5h8M12 17.5v3" />
            <path d="M9.5 9.5l3 2.2-3 2.2z" fill="currentColor" stroke="none" />
          </svg>
          <span class="hidden sm:inline">Kiosko</span>
        </a>
      </div>
    </div>
  </div>
</nav>
<div aria-hidden="true" style="height: 56px"></div>


