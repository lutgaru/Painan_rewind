---
import { Image } from "astro:assets";
import logo from "../../assets/painani1.png";
---
<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-[#050810]/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="#top" class="flex items-center gap-2">
      <Image src={logo} alt="PAINANI-1" width={32} height={32} densities={[1, 2]} class="h-8 w-8 rounded-full object-cover ring-1 ring-white/20" />
      <span class="telemetry-mono text-sm font-bold tracking-widest text-blue-300">PAINANI-1 · VOYAGE</span>
    </a>
    <div class="hidden items-center gap-5 text-sm text-gray-300 md:flex">
      <a href="#mision" class="hover:text-white">Misión</a>
      <a href="#viaje" class="hover:text-white">Revive el viaje</a>
      <a href="#fotos" class="hover:text-white">Fotos SAT</a>
      <a href="#nave" class="hover:text-white">Nave</a>
      <a href="#hitos" class="hover:text-white">Hitos</a>
    </div>
    <a href="#viaje" class="rounded-full bg-green-600 px-4 py-1.5 text-sm font-bold shadow-md transition hover:bg-green-500">
      ▶ Rewind
    </a>
  </div>
</nav>
