---
import mission from "../../data/mission.json";

const subsystems = [
  { name: "OBC", desc: "Computadora de a bordo" },
  { name: "EPS", desc: "Paneles + baterías" },
  { name: "COMMS", desc: "Banda S · FH" },
  { name: "ADCS", desc: "Giróscopos + sensores" },
  { name: "Cámaras ×4", desc: "Espectro visible" },
  { name: "GPS", desc: "Fix / no-fix" },
];
---
<section id="nave" class="apple-gutter" style="padding-top: 32px; padding-bottom: 32px; scroll-margin-top: 72px">
  <div class="reveal" style="margin-bottom: 16px">
    <p class="type-eyebrow" style="color: var(--system-blue)">Spacecraft</p>
    <h2 class="type-title1" style="margin-top: 4px">3U CubeSat · 3.3 kg.</h2>
    <p class="type-callout" style="color: var(--secondary-label); margin-top: 8px; max-width: 640px">
      Órbita baja de 447 × 460 km a 45.01°. Observación terrestre de baja resolución,
      operada como experimento tecnológico sobre México.
    </p>
  </div>

  <div class="spacecraft-grid">
    <div class="apple-card reveal" style="padding: 24px">
      <h3 class="sf-mono type-caption1" style="color: var(--system-green); letter-spacing: 0.08em">CARGA ÚTIL</h3>
      <ul style="margin-top: 8px">
        {mission.payload.map((item) => (
          <li class="flex" style="gap: 12px; padding: 12px 0; border-bottom: 0.5px solid var(--separator)">
            <span aria-hidden="true" style="width: 8px; height: 8px; margin-top: 7px; border-radius: 50%; flex-shrink: 0; background: var(--system-blue)"></span>
            <span class="type-callout">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="apple-card reveal" style="padding: 24px; align-self: start">
      <h3 class="sf-mono type-caption1" style="color: var(--system-blue); letter-spacing: 0.08em">SUBSISTEMAS</h3>
      <ul class="grid grid-cols-2" style="gap: 8px; margin-top: 16px">
        {subsystems.map((s) => (
          <li class="pressable" style="border-radius: var(--radius-m); background: var(--secondary-grouped-card); padding: 16px">
            <p class="type-headline" style="font-size: 15px">{s.name}</p>
            <p class="type-footnote" style="color: var(--secondary-label); margin-top: 2px">{s.desc}</p>
          </li>
        ))}
      </ul>
      <p class="type-footnote" style="margin-top: 16px; color: var(--tertiary-label)">
        Detalle de subsistemas: CICESE “Subsystems of Painani I” (ver Fuentes).
      </p>
    </div>
  </div>
</section>

<style>
  .spacecraft-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .spacecraft-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
</style>
