---
import mission from "../../data/mission.json";
---
<section id="nave" class="border-t border-white/10">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-2xl font-black text-blue-300">La nave · 3U CubeSat</h2>
    <p class="mt-2 max-w-3xl text-gray-400">
      Plataforma 3U de 3.3 kg en órbita baja (447 × 460 km, 45.01°). Carga útil de observación terrestre de baja resolución,
      pensada como experimento tecnológico operado sobre México.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-white/10 bg-gray-900/70 p-5">
        <h3 class="telemetry-mono text-xs font-bold tracking-widest text-green-400">CARGA ÚTIL E INSTRUMENTOS</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-gray-300">
          {mission.payload.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-white/10 bg-gray-900/70 p-5">
        <h3 class="telemetry-mono text-xs font-bold tracking-widest text-blue-300">SUBSISTEMAS (RESUMEN)</h3>
        <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
          <li class="rounded-lg bg-white/5 p-3"><strong>OBC</strong><br /><span class="text-gray-400">Computadora de a bordo</span></li>
          <li class="rounded-lg bg-white/5 p-3"><strong>EPS</strong><br /><span class="text-gray-400">Paneles + bancos de batería</span></li>
          <li class="rounded-lg bg-white/5 p-3"><strong>COMMS</strong><br /><span class="text-gray-400">Banda S · FH</span></li>
          <li class="rounded-lg bg-white/5 p-3"><strong>ADCS</strong><br /><span class="text-gray-400">Giróscopos + sensores</span></li>
          <li class="rounded-lg bg-white/5 p-3"><strong>CÁMARAS ×4</strong><br /><span class="text-gray-400">Espectro visible</span></li>
          <li class="rounded-lg bg-white/5 p-3"><strong>GPS</strong><br /><span class="text-gray-400">Fix / no-fix en baliza larga</span></li>
        </ul>
        <p class="mt-3 text-xs text-gray-500">
          Detalle de subsistemas: CICESE “Subsystems of Painani I” (ver Fuentes).
        </p>
      </div>
    </div>
  </div>
</section>
