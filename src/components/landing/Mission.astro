---
import mission from "../../data/mission.json";
---
<section id="mision" class="apple-gutter" style="padding-top: 32px; padding-bottom: 32px; scroll-margin-top: 72px">
  <div class="reveal" style="margin-bottom: 16px">
    <p class="type-eyebrow" style="color: var(--system-blue)">Misión</p>
    <h2 class="type-title1" style="margin-top: 4px">Un mensajero veloz,<br />hecho en México.</h2>
  </div>

  <div class="mission-grid">
    <div class="apple-card reveal" style="padding: 24px">
      <p class="type-body">{mission.description}</p>
      <p class="type-callout" style="margin-top: 16px; color: var(--secondary-label)">
        <strong class="type-headline">Propósito. </strong>{mission.purpose}
      </p>

      <div style="margin-top: 24px; border-radius: var(--radius-m); background: var(--secondary-grouped-card); padding: 16px">
        <h3 class="sf-mono type-caption1" style="color: var(--system-green); letter-spacing: 0.08em">LANZAMIENTO · MAKE IT RAIN</h3>
        <ul style="margin-top: 12px; display: grid; gap: 0">
          <li class="grouped-row" style="background: transparent; padding-inline: 0">
            <span class="type-subhead" style="color: var(--secondary-label)">Fecha</span>
            <span class="type-subhead" style="font-weight: 600; text-align: right">29 jun 2019 · 04:30 UTC</span>
          </li>
          <li class="grouped-row" style="background: transparent; padding-inline: 0">
            <span class="type-subhead" style="color: var(--secondary-label)">Vehículo</span>
            <span class="type-subhead" style="font-weight: 600; text-align: right">{mission.launch.vehicle}</span>
          </li>
          <li class="grouped-row" style="background: transparent; padding-inline: 0">
            <span class="type-subhead" style="color: var(--secondary-label)">Sitio</span>
            <span class="type-subhead" style="font-weight: 600; text-align: right">{mission.launch.site}</span>
          </li>
          <li class="grouped-row" style="background: transparent; padding-inline: 0">
            <span class="type-subhead" style="color: var(--secondary-label)">Rideshare</span>
            <span class="type-subhead" style="font-weight: 600; text-align: right; max-width: 55%">{mission.launch.rideshare}</span>
          </li>
        </ul>
        <p class="type-footnote" style="margin-top: 12px; color: var(--tertiary-label)">{mission.launch.note}</p>
      </div>
    </div>

    {/* Datos — archivo + ficha técnica en una sola tarjeta */}
    <div class="apple-card reveal" style="padding: 24px; align-self: start">
      <h3 class="sf-mono type-caption1" style="color: var(--system-blue); letter-spacing: 0.08em">EL ARCHIVO EN ESTA PÁGINA</h3>
      <div class="grid grid-cols-3" style="gap: 8px; margin-top: 16px">
        <div class="pressable" style="border-radius: var(--radius-m); background: color-mix(in srgb, var(--system-green) 12%, transparent); padding: 16px 8px; text-align: center">
          <p class="sf-mono type-title2" style="color: var(--system-green)">{mission.archive.shortBeacons.toLocaleString("es-MX")}</p>
          <p class="type-caption1" style="color: var(--secondary-label); margin-top: 4px">balizas<br />cortas</p>
        </div>
        <div class="pressable" style="border-radius: var(--radius-m); background: color-mix(in srgb, var(--system-blue) 12%, transparent); padding: 16px 8px; text-align: center">
          <p class="sf-mono type-title2" style="color: var(--system-blue)">{mission.archive.longBeacons.toLocaleString("es-MX")}</p>
          <p class="type-caption1" style="color: var(--secondary-label); margin-top: 4px">balizas<br />largas</p>
        </div>
        <div class="pressable" style="border-radius: var(--radius-m); background: color-mix(in srgb, #af52de 12%, transparent); padding: 16px 8px; text-align: center">
          <p class="sf-mono type-title2" style="color: #af52de">{mission.archive.tleCount.toLocaleString("es-MX")}</p>
          <p class="type-caption1" style="color: var(--secondary-label); margin-top: 4px">TLEs<br />históricos</p>
        </div>
      </div>
      <p class="type-callout" style="margin-top: 16px">Cobertura <strong>{mission.archive.coverage}</strong></p>
      <p class="type-footnote" style="margin-top: 8px; color: var(--secondary-label)">{mission.archive.note}</p>

      <div class="hairline-t" style="margin-top: 20px; padding-top: 16px">
        <h3 class="sf-mono type-caption1" style="color: var(--secondary-label); letter-spacing: 0.08em">FICHA TÉCNICA</h3>
        <dl class="grouped-list" style="border-radius: 12px; margin-top: 12px">
          {mission.quickFacts.map((f) => (
            <div class="grouped-row" style="background: var(--secondary-grouped-card); min-height: 44px; padding: 10px 14px">
              <dt class="type-footnote" style="color: var(--secondary-label)">{f.label}</dt>
              <dd class="sf-mono type-footnote" style="font-weight: 600; text-align: right">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <a href="#viaje" class="apple-btn apple-btn-tinted" style="width: 100%; margin-top: 16px">Abrir el Rewind</a>
    </div>
  </div>
</section>

<style>
  .mission-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .mission-grid { grid-template-columns: 1.1fr 0.9fr; gap: 24px; } }
</style>
