---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/gallery/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const entries = Object.entries(galleryModules)
  .map(([path, mod]) => ({ file: path.split("/").pop() ?? path, image: mod.default }))
  .sort((a, b) => a.file.localeCompare(b.file));
---
<section id="fotos" class="apple-gutter" style="padding-top: 32px; padding-bottom: 32px; scroll-margin-top: 72px">
  <div class="reveal flex items-end justify-between flex-wrap" style="gap: 8px; margin-bottom: 16px">
    <div>
      <p class="type-eyebrow" style="color: var(--system-blue)">Galería</p>
      <h2 class="type-title1" style="margin-top: 4px">Visto desde arriba.</h2>
      <p class="type-callout" style="color: var(--secondary-label); margin-top: 8px; max-width: 560px">
        Fotografías capturadas por las cámaras de PAINANI-1 en espectro visible, solo sobre territorio mexicano.
      </p>
    </div>
    <p class="sf-mono type-caption1" style="color: var(--tertiary-label); letter-spacing: 0.06em">{entries.length} FOTOS SAT</p>
  </div>

  {entries.length === 0 ? (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3" style="gap: 16px">
      {[1, 2, 3, 4, 5, 6].map((i) => (
        <div class="apple-card reveal" style="padding: 24px; min-height: 200px; display: flex; flex-direction: column; justify-content: space-between; border-style: dashed">
          <p class="sf-mono type-caption1" style="color: var(--tertiary-label)">FOTO-{i}</p>
          <p class="type-subhead" style="color: var(--secondary-label); margin-top: 24px">
            Espacio reservado. Sube <span class="sf-mono">foto-{i}.jpg</span> a <span class="sf-mono">src/assets/gallery/</span>.
          </p>
          <p class="sf-mono type-caption1" style="color: var(--system-green); margin-top: 16px">○ pendiente</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="grid sm:grid-cols-2 lg:grid-cols-3" style="gap: 16px">
      {entries.map(({ file, image }, i) => (
        <figure class="apple-card apple-card-interactive sat-photo reveal overflow-hidden" style="padding: 0; border-radius: var(--radius-l)">
          <div class="overflow-hidden" style="border-radius: var(--radius-l) var(--radius-l) 0 0">
            <Image
              src={image}
              alt={`Foto PAINANI-1 ${file}`}
              widths={[400, 800, 1200]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              format="webp"
              class="w-full object-cover"
              style="aspect-ratio: 4/3; display: block"
              loading="lazy"
            />
          </div>
          <figcaption class="flex items-center justify-between" style="padding: 12px 16px">
            <span class="sf-mono type-caption1 truncate" style="color: var(--secondary-label)">{file}</span>
            <span class="sf-mono type-caption2" style="color: var(--tertiary-label)">{String(i + 1).padStart(2, "0")}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</section>
