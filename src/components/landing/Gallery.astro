---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Optimized at build time (responsive sizes + WebP output).
// New photos dropped into src/assets/gallery/ appear automatically.
const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/gallery/*.{jpg,jpeg,png,webp}",
  { eager: true }
);
const entries = Object.entries(galleryModules)
  .map(([path, mod]) => ({ file: path.split("/").pop() ?? path, image: mod.default }))
  .sort((a, b) => a.file.localeCompare(b.file));
---
<section id="fotos" class="border-t border-white/10 bg-[#070c16]">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-black text-blue-300">Fotos tomadas desde el SAT</h2>
      </div>
      <p class="telemetry-mono text-xs text-gray-500">{entries.length} FOTOS SAT DETECTADAS</p>
    </div>

    {entries.length === 0 ? (
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {[1, 2, 3, 4, 5, 6].map((i) => (
          <div class="flex min-h-48 flex-col justify-between rounded-2xl border border-dashed border-white/20 bg-gray-900/60 p-5">
            <p class="telemetry-mono text-xs text-gray-500">SLOT FOTO-{i}</p>
            <p class="mt-6 text-sm text-gray-400">
              Espacio reservado para foto SAT {i}. Sube <span class="telemetry-mono text-gray-300">foto-{i}.jpg</span> a <span class="telemetry-mono text-gray-300">src/assets/gallery/</span>.
            </p>
            <p class="telemetry-mono mt-4 text-xs text-green-400">○ pendiente</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-6 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
        {entries.map(({ file, image }) => (
          <figure class="overflow-hidden rounded-2xl border border-white/10 bg-gray-900/70">
            <Image src={image} alt={`Foto PAINANI-1 ${file}`} widths={[400, 800, 1200]} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" format="webp" class="aspect-[4/3] w-full object-cover" loading="lazy" />
            <figcaption class="telemetry-mono truncate px-3 py-2 text-xs text-gray-400">{file}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
