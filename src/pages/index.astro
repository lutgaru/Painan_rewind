---
import Layout from "../layouts/Layout.astro";
import World from "../components/world";
import Timeline from "../components/timeline.jsx";
import ShortPlots from "../components/ShortPlots.jsx";
import LongPlots from "../components/LongPlots.jsx";
import painanitles from "../data/painanitles.json";
import Navbar from "../components/landing/Navbar.astro";
import Hero from "../components/landing/Hero.astro";
import Mission from "../components/landing/Mission.astro";
import Gallery from "../components/landing/Gallery.astro";
import MilestonesFooter from "../components/landing/MilestonesFooter.astro";
---

<Layout title="PAINANI-1 · Mission">
  <Navbar />
  <main>
    <Hero />
    <Mission />

    {/* Viaje / Rewind — grouped Apple cards */}
    <section id="viaje" class="apple-gutter" style="padding-top: 32px; padding-bottom: 32px; scroll-margin-top: 72px">
      <div class="reveal" style="margin-bottom: 16px">
        <p class="type-eyebrow" style="color: var(--system-green)">● En vivo desde el archivo · Painan Rewind</p>
        <h2 class="type-title1" style="margin-top: 4px">Revive el viaje.</h2>
        <p class="type-callout" style="color: var(--secondary-label); margin-top: 8px; max-width: 680px">
          Mueve la línea de tiempo para propagar la órbita con TLEs históricos y ver la telemetría real
          de balizas cortas y largas. El globo sigue al satélite.
        </p>
      </div>

      <div class="reveal" style="margin-bottom: 16px">
        <Timeline client:only="react" />
      </div>

      <div class="voyage-grid">
        <div class="apple-card reveal overflow-hidden" style="padding: 0">
          <div class="flex items-center justify-between flex-wrap" style="gap: 8px; padding: 16px 20px 12px">
            <h3 class="type-headline" style="font-size: 15px">Órbita propagada</h3>
            <span class="sf-mono type-caption1 inline-flex min-h-[28px] items-center gap-2 rounded-full px-3" style="background: color-mix(in srgb, var(--system-green) 12%, transparent); color: var(--system-green); font-weight: 600">
              <span aria-hidden="true" style="width: 7px; height: 7px; border-radius: 50%; background: currentColor"></span>
              satellite.js
            </span>
          </div>
          <div class="relative w-full" style="height: 55vh; min-height: 380px; background: #000; border-top: 0.5px solid var(--separator)">
            <div class="absolute inset-0">
              <World tle={painanitles[0]} client:only="react" />
            </div>
          </div>
          <p class="sf-mono type-caption2" style="color: var(--tertiary-label); padding: 12px 20px 16px; letter-spacing: 0.04em">
            ARRASTRA PARA EXPLORAR · EL GLOBO SIGUE AL SATÉLITE
          </p>
        </div>

        <div class="apple-card reveal" style="padding: 20px">
          <h3 class="sf-mono type-caption1" style="color: var(--system-blue); letter-spacing: 0.08em">BALIZAS CORTAS</h3>
          <p class="type-footnote" style="color: var(--secondary-label); margin-top: 4px">Temperaturas · voltajes · corrientes</p>
          <div style="margin-top: 8px; max-height: 56vh; overflow-y: auto">
            <ShortPlots client:only="react" />
          </div>
        </div>
      </div>

      <div class="apple-card reveal" style="padding: 20px; margin-top: 16px">
        <div class="flex items-end justify-between flex-wrap" style="gap: 8px; margin-bottom: 8px">
          <div>
            <h3 class="sf-mono type-caption1" style="color: var(--system-blue); letter-spacing: 0.08em">BALIZAS LARGAS</h3>
            <p class="type-footnote" style="color: var(--secondary-label); margin-top: 4px">Giróscopos · baterías · paneles</p>
          </div>
          <div class="apple-segmented" role="tablist" aria-label="Vista de gráficas">
            <button role="tab" aria-selected="true" class="pressable">Giros</button>
            <button role="tab" aria-selected="false" class="pressable">Energía</button>
          </div>
        </div>
        <LongPlots client:only="react" />
      </div>
    </section>

    <Gallery />
    <MilestonesFooter />
  </main>
</Layout>

<style>
  .voyage-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 1024px) {
    .voyage-grid { grid-template-columns: 1.75fr 1fr; align-items: stretch; }
  }
</style>
