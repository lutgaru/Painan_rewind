---
import "../styles/global.css";
import "../styles/kiosk.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Kiosk, { type KioskSlide } from "../components/kiosk/Kiosk";
import { getGalleryMeta } from "../data/gallery";
import mission from "../data/mission.json";

const base = import.meta.env.BASE_URL;

const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp}",
  { eager: true }
);

const files = Object.entries(galleryModules).sort(([a], [b]) => a.localeCompare(b));

const slides: KioskSlide[] = await Promise.all(
  files.map(async ([path, mod]) => {
    const file = path.split("/").pop() ?? path;
    const meta = getGalleryMeta(file);
    const [full, thumb] = await Promise.all([
      getImage({ src: mod.default, width: 2400, format: "webp", quality: 84 }),
      getImage({ src: mod.default, width: 1200, format: "webp", quality: 80 }),
    ]);
    return {
      file,
      src: full.src,
      thumb: thumb.src,
      width: mod.default.width,
      height: mod.default.height,
      title: meta.title,
      description: meta.description,
    };
  })
);
---
<!doctype html>
<html lang="es" data-theme="dark" class="kiosk-root">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href={`${base}painani1.png`} />
    <link rel="apple-touch-icon" href={`${base}painani1.png`} />
    <meta name="robots" content="noindex" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content={`${mission.name} · Modo kiosko a pantalla completa — globo 3D, telemetría, video y galería SAT.`}
    />
    <title>{mission.name} · Kiosko</title>
  </head>
  <body class="kiosk-body">
    <Kiosk client:only="react" slides={slides} satSrc={`${base}sinfondo3.png`} exitHref={base} />
  </body>
</html>
