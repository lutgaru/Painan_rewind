---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const { title = "PAINANI-1 · Mission Voyage", description = "Página de misión del primer nanosatélite mexicano: revive el viaje completo de PAINANI-1 con globo 3D, telemetría y fotos SAT." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/painani1.png" />
    <link rel="apple-touch-icon" href="/painani1.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-[#050810] text-white antialiased">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: #050810;
  }
</style>
